+@Composable
+private fun SpaceBarTouchAreaSetting() {
+    val area = useSharedPrefsInt(Settings.PREF_SPACE_BAR_TOUCH_AREA, 0)
+    val options = mapOf(
+        0 to stringResource(R.string.space_bar_touch_area_normal),
+        15 to stringResource(R.string.space_bar_touch_area_larger),
+        30 to stringResource(R.string.space_bar_touch_area_largest),
+    )
+    DropDownPickerSettingItem(
+        label = stringResource(R.string.space_bar_touch_area),
+        options = options.keys.toList(),
+        selection = area.value,
+        onSet = { area.setValue(it) },
+        getDisplayName = { options[it] ?: "+$it%" },
+    )
