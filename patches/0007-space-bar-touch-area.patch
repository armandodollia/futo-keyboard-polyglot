+    /**
+     * Taps just above the space bar type a space: the gap between the bottom letter row and the space bar (which
+     * otherwise belongs to the letter above it, often b), plus a band of the letter row - "Space bar touch area" in
+     * % of a key height, or a third of a key height while the word typed so far is complete (space is a boosted next
+     * key). Only directly above the space bar.
+     */
+    @Nullable
+    private Key detectSpaceBarBand(final int touchX, final int touchY, final SettingsValues settingsValues) {
+        final Key spaceKey = mKeyboard.getKey(Constants.CODE_SPACE);
+        if (spaceKey == null) {
+            return null;
+        }
+        final int spaceTop = spaceKey.getY();
+        if (touchY >= spaceTop || touchX < spaceKey.getX() || touchX >= spaceKey.getX() + spaceKey.getWidth()) {
+            return null;
+        }
+        final boolean spaceBoosted = mBoostedCodePoints != null && mBoostedCodePoints.contains(Constants.CODE_SPACE);
+        final float bandFraction = Math.max(settingsValues.mSpaceBarTouchAreaPercent / 100.0f, spaceBoosted ? 0.33f : 0.0f);
+        final int band = spaceKey.getVerticalGap() + (int) (bandFraction * mKeyboard.mMostCommonKeyHeight);
+        return touchY >= spaceTop - band ? spaceKey : null;
+    }
+
     public void updateBoostedCodePoints(@Nullable Set<Integer> validNextCodePoints) {
         mBoostedCodePoints = validNextCodePoints;
     }
