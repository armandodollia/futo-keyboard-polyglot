+@Composable
+private fun SpaceBarTouchAreaSetting() {
+    val area = useSharedPrefsInt(Settings.PREF_SPACE_BAR_TOUCH_AREA, 0)
+    val options = mapOf(
+        -4 to stringResource(R.string.space_bar_touch_area_off),
+        -3 to stringResource(R.string.space_bar_touch_area_smallest),
+        -2 to stringResource(R.string.space_bar_touch_area_smaller),
