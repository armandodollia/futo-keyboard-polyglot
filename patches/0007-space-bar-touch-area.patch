+    /**
+     * Taps just above the space bar type a space: part or all of the gap between the bottom letter row and the space
+     * bar (which otherwise belongs to the letter above it, often b), plus a band of the letter row that can grow while
+     * the word typed so far is complete (space is a boosted next key). Only directly above the space bar.
+     * "Space bar touch area" levels (Settings.PREF_SPACE_BAR_TOUCH_AREA):
+     *   -4 off (stock), -3 half the gap, -2 the gap, -1 the gap + 15% at a complete word unless the letter under the
+     *   finger could also continue the word, 0 the gap + 33% at a complete word, 15/30 the gap + that % always
+     *   (and 33% at a complete word).
+     */
+    @Nullable
+    private Key detectSpaceBarBand(final int touchX, final int touchY, final SettingsValues settingsValues) {
+        final Key spaceKey = mKeyboard.getKey(Constants.CODE_SPACE);
+        if (spaceKey == null) {
+            return null;
+        }
+        final int spaceTop = spaceKey.getY();
+        if (touchY >= spaceTop || touchX < spaceKey.getX() || touchX >= spaceKey.getX() + spaceKey.getWidth()) {
+            return null;
+        }
+        final int level = settingsValues.mSpaceBarTouchAreaPercent;
+        if (level <= -4) {
+            return null;
+        }
+        final boolean spaceBoosted = mBoostedCodePoints != null && mBoostedCodePoints.contains(Constants.CODE_SPACE);
+        float gapFraction = 1.0f;
+        float bandFraction;
+        if (level == -3) {
+            gapFraction = 0.5f;
+            bandFraction = 0.0f;
+        } else if (level == -2) {
+            bandFraction = 0.0f;
+        } else if (level == -1) {
+            bandFraction = spaceBoosted && !letterUnderTouchIsBoosted(touchX, touchY) ? 0.15f : 0.0f;
+        } else {
+            bandFraction = Math.max(level / 100.0f, spaceBoosted ? 0.33f : 0.0f);
+        }
+        final int band = (int) (spaceKey.getVerticalGap() * gapFraction + bandFraction * mKeyboard.mMostCommonKeyHeight);
+        return touchY >= spaceTop - band ? spaceKey : null;
+    }
+
+    /** Whether the letter key the touch is on could also continue the word (it's a boosted next key too). */
+    private boolean letterUnderTouchIsBoosted(final int touchX, final int touchY) {
+        if (mBoostedCodePoints == null) {
+            return false;
+        }
+        for (final Key key : mKeyboard.getNearestKeys(touchX, touchY)) {
+            if (key.isOnKey(touchX, touchY) && mBoostedCodePoints.contains(key.getCode())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
     public void updateBoostedCodePoints(@Nullable Set<Integer> validNextCodePoints) {
         mBoostedCodePoints = validNextCodePoints;
     }
